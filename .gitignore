# Lista de permitidos: o git ignora tudo, exceto os arquivos do site.
# Arquivo novo do site entra aqui e em .githooks/pre-push (docs/22-publicacao-site.md).
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/CNAME
!/README.md
!/index.html
!/config.js
!/api.js
!/app.js
!/styles.css
!/whatsapp-cadastro.html
!/whatsapp-cadastro.js
!/screens/

/.githooks/*
!/.githooks/pre-push
/screens/*
!/screens/*.js
